{
  "name": "jdx-accessible-converter",
  "version": "0.4.0",
  "private": true,
  "description": "Deterministic converter for saved JDXpert job-description HTML",
  "main": "parse-jdx.js",
  "scripts": {
    "bundle": "esbuild parse-jdx.js --bundle --platform=node --format=cjs --outfile=parse-jdx.bundle.cjs",
    "build:exe": "npm run bundle && node --build-sea sea-config.json",
    "convert": "node parse-jdx.js",
    "sample:uiuc": "node parse-jdx.js \"example.html\""
  },
  "dependencies": {
    "cheerio": "^1.0.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}